<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- Ajustar servidor, usuario y contraseña a tu SQL Server -->
    <add name="Biblioteca"
         connectionString="Server=localhost,1433;User Id=sa;Password=TU_PASSWORD;Database=bbdBiblioteca;TrustServerCertificate=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" culture="es-AR" uiCulture="es" />
  </system.web>
</configuration>
