<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="BibliotecaWeb.Site" %>

<!DOCTYPE html>
<html lang="es">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Biblioteca Universitaria</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    <form id="form1" runat="server">

        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold" href="Default.aspx">Biblioteca Universitaria</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal" aria-controls="menuPrincipal" aria-expanded="false" aria-label="Menú">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="menuPrincipal">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item"><a class='nav-link <%= Activo("Default.aspx") %>' href="Default.aspx">Inicio</a></li>
                        <li class="nav-item"><a class='nav-link <%= Activo("Libros.aspx") %>' href="Libros.aspx">Libros</a></li>
                        <li class="nav-item"><a class='nav-link <%= Activo("Editoriales.aspx") %>' href="Editoriales.aspx">Editoriales</a></li>
                        <li class="nav-item"><a class='nav-link <%= Activo("Autores.aspx") %>' href="Autores.aspx">Autores</a></li>
                        <li class="nav-item"><a class='nav-link <%= Activo("Socios.aspx") %>' href="Socios.aspx">Socios</a></li>
                        <li class="nav-item"><a class='nav-link <%= Activo("Prestamos.aspx") %>' href="Prestamos.aspx">Préstamos</a></li>
                        <li class="nav-item"><a class='nav-link <%= Activo("Multas.aspx") %>' href="Multas.aspx">Multas</a></li>
                        <li class="nav-item"><a class='nav-link <%= Activo("Reportes.aspx") %>' href="Reportes.aspx">Reportes</a></li>
                    </ul>
                </div>
            </div>
        </nav>

        <main class="container my-4 flex-grow-1">
            <asp:Panel ID="pnlMensaje" runat="server" Visible="false" CssClass="alert alert-info">
                <asp:Label ID="lblMensaje" runat="server"></asp:Label>
            </asp:Panel>

            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </main>

        <footer class="bg-dark text-center py-3 mt-auto">
            <small class="text-white-50">&copy; <%: DateTime.Now.Year %> - TPI Base de Datos II - UTN</small>
        </footer>

    </form>
</body>
</html>
